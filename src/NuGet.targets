<Project>
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Authors>Pact Foundation; Max Lancaster</Authors>
    <PackageProjectUrl>https://github.com/pact-foundation/pact-net-extensions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pact-foundation/pact-net-extensions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)$(MSBuildProjectName)/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="PreventLocalDependencyRelease" BeforeTargets="Pack" Condition="'$(ReleaseBuild)' == 'true' and '$(PactNetVersion)' == '5.0.0-plugin.551.local'">
    <Error Text="Release blocked: replace PactNetVersion with a published PactNet version containing the API from PR #551 and validate compatibility first." />
  </Target>
</Project>